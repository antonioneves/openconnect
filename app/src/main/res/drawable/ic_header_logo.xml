<?xml version="1.0" encoding="utf-8"?>
<!-- the launcher icon as a circle, for the TV action bar. The 12dp on the right makes the
     action bar title line up with the TV page content (8dp inset + 48dp = 56dp) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_header_logo_bg"
        android:width="36dp"
        android:height="36dp"
        android:right="12dp"
        android:gravity="start|center_vertical" />
    <!-- the foreground has a transparent margin, so it is drawn larger than the circle -->
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:width="48dp"
        android:height="48dp"
        android:left="-6dp"
        android:gravity="start|center_vertical" />
</layer-list>
