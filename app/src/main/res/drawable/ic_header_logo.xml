<?xml version="1.0" encoding="utf-8"?>
<!-- the action bar logo: just the green connector of the launcher icon, with no background.
     The 12dp on the right is the gap before the title; on TV it also makes the title line up
     with the page content (8dp inset + 48dp = 56dp).
     LogoSpinner turns the connector while a connection is being set up -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/logo_connector"
        android:width="36dp"
        android:height="36dp"
        android:right="12dp"
        android:gravity="start|center_vertical">
        <rotate
            android:drawable="@drawable/ic_logo_connector"
            android:fromDegrees="0"
            android:toDegrees="360"
            android:pivotX="50%"
            android:pivotY="50%" />
    </item>
</layer-list>
