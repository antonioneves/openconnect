<?xml version="1.0" encoding="utf-8"?>
<!-- the launcher icon without its background, for the action bar: a ring with the green
     connector in it. The 16dp on the right is the gap before the title; on TV it also makes the
     title line up with the page content (8dp inset + 48dp = 56dp).
     The ring and the connector are separate layers: LogoSpinner turns the connector while a
     connection is being set up -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_logo_ring"
        android:width="32dp"
        android:height="32dp"
        android:right="16dp"
        android:gravity="start|center_vertical" />
    <item
        android:id="@+id/logo_connector"
        android:width="32dp"
        android:height="32dp"
        android:right="16dp"
        android:gravity="start|center_vertical">
        <rotate
            android:drawable="@drawable/ic_logo_connector"
            android:fromDegrees="0"
            android:toDegrees="360"
            android:pivotX="50%"
            android:pivotY="50%" />
    </item>
</layer-list>
