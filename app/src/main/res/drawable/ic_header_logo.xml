<?xml version="1.0" encoding="utf-8"?>
<!-- the launcher icon as a circle, for the action bar. The 12dp on the right is the gap
     before the title; on TV it also makes the title line up with the page content
     (8dp inset + 48dp = 56dp).
     The ring and the connector are separate layers: LogoSpinner turns the connector while a
     connection is being set up -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_header_logo_bg"
        android:width="36dp"
        android:height="36dp"
        android:right="12dp"
        android:gravity="start|center_vertical" />
    <!-- the foreground has a transparent margin, so it is drawn larger than the circle -->
    <item
        android:drawable="@drawable/ic_logo_ring"
        android:width="48dp"
        android:height="48dp"
        android:left="-6dp"
        android:gravity="start|center_vertical" />
    <item
        android:id="@+id/logo_connector"
        android:width="48dp"
        android:height="48dp"
        android:left="-6dp"
        android:gravity="start|center_vertical">
        <rotate
            android:drawable="@drawable/ic_logo_connector"
            android:fromDegrees="0"
            android:toDegrees="360"
            android:pivotX="50%"
            android:pivotY="50%" />
    </item>
</layer-list>
