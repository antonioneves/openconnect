<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/stdpadding"
    android:paddingRight="@dimen/stdpadding"
    android:paddingTop="@dimen/stdpadding" >

    <TextView android:text="@string/speed_waiting"
        android:singleLine="true"
        android:id="@+id/speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/stdpadding"/>

    <ListView
        android:id="@android:id/list"
        android:transcriptMode="normal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- the TV has no overflow menu: the log actions live here instead -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/stdpadding"
        android:paddingBottom="@dimen/stdpadding" >

        <com.google.android.material.button.MaterialButton
            android:id="@+id/log_clear"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/clear_log" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/log_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/disconnect" />

    </LinearLayout>

</LinearLayout>
